/* ==UserStyle==
@name         Power-YoungCoder
@namespace    https://github.com/oyeah028/Power-YoungCoder
@version      1.2.6
@description  为 YoungCoder 修改设计：亮/暗双配色、可调节的亚克力材质、统一卡片与控件圆角、自定义背景和正文/代码字体。改版后的站点把组件颜色收拢成了 CSS 变量（--home-*、--list-*、--yc-* 等），脚本会把它们一并映射到本主题调色板，避免新版组件保持站点原色。
@author       oyeah(deepseek二开)
@license      CC-BY-NC-SA-4.0
@preprocessor stylus

@var checkbox dark-mode "深色模式" 1

@var text font-stack "全局字体" "'Inter','HarmonyOS Sans SC','MiSans','Noto Sans SC',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif"
@var text font-stack-codeblock "代码块字体" "'JetBrains Mono','Cascadia Code','Fira Code',ui-monospace,SFMono-Regular,Consolas,'Noto Sans SC',monospace"
@var range text-font-size "正文文字大小" [15, 12, 20, "px"]
@var range code-font-size "代码文字大小" [13, 10, 18, "px"]

@var range corner-radius "卡片圆角" [16, 0, 28, "px"]
@var range control-radius "按钮与输入框圆角" [10, 0, 24, "px"]

@var text main-background "自定义背景图片（写成 url(...) 形式）" "url(https://cdn.luogu.com.cn/upload/image_hosting/6inm42cv.webp)"
@var checkbox background-fixed "背景固定不随页面滚动" 1

@var text content-opacity "内容不透明度（0 为完全透明，1 为不透明）" 1

@var checkbox header-acrylic "顶栏亚克力效果" 1
@var checkbox nav-acrylic "侧栏亚克力效果" 1
@var checkbox card-acrylic "卡片亚克力效果" 1
@var checkbox footer-acrylic "底栏亚克力效果" 1
@var checkbox anymore-acrylic "其余亚克力效果" 1
@var text acrylic-opacity "亚克力不透明度（0.45 至 0.85）" 0.72
@var range acrylic-blur "亚克力模糊半径" [20, 0, 36, "px"]

@var checkbox animations "动画" 1
==/UserStyle== */

@-moz-document domain("youngcoder.cn")

    //! 调色板 ---------------------------------------------------------

    if dark-mode
        body_bg_color = #181c27
        navbar_bg_color = #1f3144
        navbar_text_color = #d0d0d0
        header_bg_color = #1f3144
        text_color = #c4c6c9
        sec_text_color = #a7a9ad
        board_color = #252d38
        post_text_color = #c4c6c9
        post_heading_color = #c4c6c9
        post_link_color = #1589e9
        link_hover_color = #30a9de
        line_color = #435266
        noMatterLineColor = #43526618
        button_text_color = #d0d0d0
        button_hover_bg_color = #46647e
        selection_bg_color = #9696c84d
        acrylic_bg_color = #000000
        textBoxBackgroudColor = #8080ad3d
        acrylic_sheen_color = rgba(255, 255, 255, .06)
        glass_highlight_color = rgba(255, 255, 255, .09)
        glass_shadow_color = rgba(0, 0, 0, .3)
        effective_acrylic_opacity = acrylic-opacity
        header_glass_opacity = 0.62
        nav_glass_opacity = 0.68
        codeblock_bg_color = #0d1117
        inlinecode_bg_color = #636e7b66
        codeblock_text_color = #c9d1d9
        codeblock_line_color = #30363d
        scrollbar_track_color = #181c27
        scrollbar_thumb_color = #687582
        scrollbar_hover_color = #5e72e4
        token_comment_color = #8b949e
        token_string_color = #a5d6ff
        token_keyword_color = #ff7b72
        token_function_color = #d2a8ff
        token_number_color = #79c0ff
        token_punct_color = #c9d1d9
        token_class_color = #7ee787
        token_attr_color = #ffa657
        token_regex_color = #a5d6ff
        canvas_color = body_bg_color
        surface_color = board_color
        raised_color = #2b3442
        inset_color = #1b202a
        alternate_color = #212a36
        hover_color = #303c4b
        separator_color = line_color
        primary_text_color = post_text_color
        secondary_text_color = sec_text_color
    else
        body_bg_color = #eee
        navbar_bg_color = #eeeeee
        navbar_text_color = #3c4858
        header_bg_color = #5eafca // Hydro 原本的顶栏蓝，保留品牌色
        text_color = #3c4858
        sec_text_color = #718096
        board_color = #fff
        post_text_color = #2c3e50
        post_heading_color = #1a202c
        post_link_color = #0366d6
        link_hover_color = #5f9fd6
        line_color = #e4e4e4
        button_text_color = #555
        button_hover_bg_color = #f2f3f5
        selection_bg_color = #95bce3
        acrylic_bg_color = #ffffff
        acrylic_sheen_color = rgba(255, 255, 255, .4)
        glass_highlight_color = rgba(255, 255, 255, .75)
        glass_shadow_color = rgba(31, 41, 55, .13)
        effective_acrylic_opacity = acrylic-opacity + .1
        header_glass_opacity = 0.84
        nav_glass_opacity = 0.86
        codeblock_bg_color = #f8f8f8
        inlinecode_bg_color = #636e7b26
        codeblock_text_color = #393a34
        codeblock_line_color = #e4e4e4
        scrollbar_track_color = #eeeeee
        scrollbar_thumb_color = #c4c6c9
        scrollbar_hover_color = #a6a6a6
        token_comment_color = null
        token_string_color = null
        token_keyword_color = null
        token_function_color = null
        token_number_color = null
        token_punct_color = null
        token_class_color = null
        token_attr_color = null
        token_regex_color = null
        canvas_color = body_bg_color
        surface_color = board_color
        raised_color = #f4f7fb
        inset_color = #fafbfd
        alternate_color = #fbfcfe
        hover_color = button_hover_bg_color
        separator_color = line_color
        primary_text_color = post_text_color
        secondary_text_color = sec_text_color

    // 背景
    bg = main-background

    // 壁纸加载前也保持主题底色，避免深色模式先闪成站点浅色。
    panel_bg_color = body_bg_color

    //! 亚克力材质 -----------------------------------------------------

    // 直接画在控件自身。新版站点的组件背景规则会读取 CSS 变量，伪元素在
    // 多层透明背景之间容易被盖住；直接声明同时配合变量覆盖，在亮暗主题
    // 和各个新版组件上表现一致。
    acrylic(arc-opacity=0.5, blur-radius=10px)
        acr-bgcolor = rgba(acrylic_bg_color, arc-opacity)
        background-image linear-gradient(145deg, acrylic_sheen_color, transparent 45%) !important
        background-color acr-bgcolor !important
        -webkit-backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        box-shadow    0 1px    0        glass_highlight_color inset,
                    0 18px    48px     glass_shadow_color !important

    // 直接改背景的实现，不需要动 z-index，也不会影响 border-radius
    acrylic-bg(arc-opacity=0.5, blur-radius=10px)
        acr-bgcolor = rgba(acrylic_bg_color, arc-opacity)
        background-image linear-gradient(145deg, acrylic_sheen_color, transparent 45%) !important
        background-color acr-bgcolor !important
        -webkit-backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        box-shadow    0 1px    0        glass_highlight_color inset,
                    0 14px    38px     glass_shadow_color !important

    // 指定底色的玻璃材质。顶栏自带品牌色（浅色下是 Hydro 的蓝），
    // 用 acrylic_bg_color 的话浅色下会变成白色，白色 logo 就看不见了
    glass(tint-color, arc-opacity=0.5, blur-radius=10px)
        background-color rgba(tint-color, arc-opacity) !important
        -webkit-backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        box-shadow    0 1px    0        glass_highlight_color inset,
                    0 10px    32px     glass_shadow_color !important

    radius-all(value)
        border-radius value !important
        border-top-left-radius value !important
        border-top-right-radius value !important
        border-bottom-right-radius value !important
        border-bottom-left-radius value !important

    //! 全局 -----------------------------------------------------------

    html, body
        scroll-behavior smooth
        background-color panel_bg_color !important

    // 页面背景：vj4 的 #panel 才是真正铺底色的容器（原本是 #edf0f2）
    // 只改 .main 的话顶栏、底栏前后的底色仍然会盖住背景图
    #panel
        background-color panel_bg_color !important
        background-image bg !important
        background-repeat no-repeat !important
        background-size cover !important
        background-position center !important
        if background-fixed
            &::before
                content ""
                position fixed
                top 0
                left 0
                right 0
                bottom 0
                z-index -1
                pointer-events none
                background-image bg
                background-repeat no-repeat
                background-size cover
                background-position center

    // 站点自带的沉浸式布局背景
    .layout--immersive #panel
    .layout--immersive .header
        background-image none !important

    .main
        background none !important

    *::selection
        background selection_bg_color

    ::-webkit-scrollbar
        background scrollbar_track_color
        width 7px
        height 7px
    ::-webkit-scrollbar-thumb
        background scrollbar_thumb_color
    ::-webkit-scrollbar-thumb:hover
        background scrollbar_hover_color
    ::-webkit-scrollbar-corner
        background-color transparent

    body
        font-family font-stack !important
        color text_color !important

    // 站点会在容器和表单控件上分别声明字体，只改 body 无法保证正文与控件
    // 都遵循主题设置。图标字体由图标元素自己的规则覆盖，不受这组继承影响。
    button, input, textarea, select, .main, .typo, .yc-homepage
        font-family font-stack !important

    // 站点把半径变量定义在 :root，并用高权重组件规则消费它们。把主题半径
    // 定义在 body 上，既能让依赖根变量的站点组件继承新值，也能避免与站点
    // 根选择器的层叠顺序耦合。
    html:root body
        --yc-theme-card-radius corner-radius
        --yc-theme-control-radius control-radius
        --yc-corner-radius corner-radius !important
        --yc-control-radius control-radius !important
        --yc-small-radius calc(control-radius - 2px) !important
        --yc-inner-radius calc(corner-radius - 2px) !important

    // 站点给不少组件单独写死了文字色（例如 .training__intro 的 #777），
    // 加 !important 才能压住；后代元素自己的 color 规则依然优先，不受影响
    .main
        color post_text_color !important

    code, pre, kbd, samp, .code-toolbar
        font-family font-stack-codeblock !important

    //! 站点组件变量 ------------------------------------------------

    // 改版后的站点把组件颜色都收拢成了 CSS 变量（--home-*、--list-*、--yc-*
    // 等等），每个变量自带一套浅色值，站点自己的深色模式再换成另一套。脚本是
    // 独立强制配色的（不跟随站点主题开关），所以必须自己把这批变量写一遍，
    // 否则作业/比赛/课程/消息这些新版组件会始终保持站点原本的浅色底。
    //
    // 取值规则：中性用途（底色、分隔线、正文）映射到本主题调色板；带色相的
    // （状态色、提示色、主题强调色）沿用站点自己的值，避免把语义色抹平。只对
    // 站点会随主题切换的变量做处理，纯版式变量（宽高、间距、圆角）不碰。
    // 站点改版后可以用仓库里的 tools/gen-tokens 重新生成这一段。

    // 同值 token 合并成一条 mixin 调用，编译后的变量与逐条声明完全一致。
    set-theme-tokens(tokens, value)
        for token in tokens
            {token}: value !important

    site-token-values-light()
        set-theme-tokens('--article-blue' '--contest-accent' '--copy-accent' '--course-blue' '--file-dialog-accent' '--sidebar-accent' '--statement-tab-active' '--yc-dialog-accent' '--yc-msg-accent' '--yc-side-accent', #1677d2)
        set-theme-tokens('--article-code' '--auth-input' '--copy-input' '--detail-rate-track' '--discussion-input' '--file-dialog-input' '--hw-input' '--list-input' '--md-theme-code-copy-tips-color' '--statement-code' '--yc-contest-scroll-track' '--yc-dialog-input' '--yc-info-input' '--yc-md-input', inset_color)
        set-theme-tokens('--article-ink' '--article-title' '--author-stats-ink' '--bulletin-ink' '--contest-ink' '--copy-ink' '--course-text' '--discussion-ink' '--discussion-pending-label-ink' '--discussion-resubmit-label-ink' '--file-dialog-ink' '--home-ink' '--hw-ink' '--list-ink' '--pl-text' '--sidebar-ink' '--yc-cover-ink' '--yc-dialog-ink' '--yc-filter-ink' '--yc-info-ink' '--yc-md-ink' '--yc-msg-text' '--yc-side-ink', primary_text_color)
        set-theme-tokens('--article-inline', #fff1f0)
