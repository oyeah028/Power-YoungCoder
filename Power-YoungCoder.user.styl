    .syntax-hl .token.boolean
    .syntax-hl .token.inserted
    .syntax-hl .token.number
    .syntax-hl .token.symbol
    .syntax-hl .token.url
        color token_number_color if token_number_color

    .syntax-hl .token.operator
    .syntax-hl .token.punctuation
        color token_punct_color if token_punct_color

    .syntax-hl .token.class-name
        color token_class_color if token_class_color

