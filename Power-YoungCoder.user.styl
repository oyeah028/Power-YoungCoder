        set-theme-tokens('--bulletin-button' '--ca-blue-soft' '--contest-accent-bg' '--contest-problem-hover' '--contest-tab-selected' '--discussion-blue-soft' '--discussion-hover' '--discussion-resubmit-bg' '--home-hover' '--hw-blue-soft' '--hw-row-hover' '--list-blue-soft' '--list-hover' '--node-active' '--pl-blue-soft' '--pl-hover' '--rank-blue-soft' '--yc-page-blue-soft', #e8f3ff)
