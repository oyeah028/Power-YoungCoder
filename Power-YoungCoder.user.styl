        // @site-dark-rules-end

    //! 顶栏 -----------------------------------------------------------

    // 改版后站点把原来的顶部横幅并进了固定导航条：logo 与站点名现在都在
    // #menu.nav 里（见下），只有窄屏下才显示 .header--mobile 这条细顶栏。
    // 因此「顶栏亚克力」这个开关现在作用于窄屏顶栏，桌面端由「侧栏亚克力」
    // （#menu.nav）负责。
    .header--mobile
        background-image none !important
        if header-acrylic
            glass(header_bg_color, 0.55)
        else
            background-color header_bg_color !important
        color #fff !important

        .header--mobile__domain
        .header__hamburger
            color #fff !important

        .hamburger-inner
            &
            &:before
            &:after
                background-color #fff !important

    // 固定导航条
    #menu.nav
        if nav-acrylic
            glass(navbar_bg_color)
        else
            background-color navbar_bg_color !important
        color navbar_text_color !important

        // 覆盖站点自带的滚动变色
        &.floating
            if nav-acrylic
                glass(navbar_bg_color)
            else
                background-color navbar_bg_color !important
            box-shadow none

        .nav__list-item
            color navbar_text_color !important

        .nav__item
        .nav__item--round
            color navbar_text_color !important
            border-radius 6px
            &:active
            &:visited
                color navbar_text_color !important
            &:hover
                color navbar_text_color !important
                background button_hover_bg_color
            &.nav--active
                border-color link_hover_color
                &:before
                    box-shadow none

    // 侧栏（小屏幕下的抽屉菜单）
    .slideout-menu
        if nav-acrylic
            glass(navbar_bg_color)
        else
            background-color navbar_bg_color !important
        color navbar_text_color !important
        opacity content-opacity

    .slideout-overlay
        opacity content-opacity

    //! 卡片 -----------------------------------------------------------

    // vj4 的卡片是 .section，原本是纯白 + 大阴影。
    // 改版后的站点又加了几种独立的卡片容器（排名面板、个人主页热力图、
    // 首页卡片），它们不在 .section 结构里，但外观相同，所以共用同一套配方
    .section
    .rank-panel
    .profile-heatmap-card
    .yc-home-card
        if card-acrylic
            // acrylic() 的伪元素是绝对定位的，必须给卡片建立定位上下文
            position relative
            // 与 argon-luogu 的卡片配方保持一致（0.6 / 20px）
            acrylic(0.6, 20px)
            box-shadow none !important
        else
            background board_color !important
            box-shadow none !important
        color post_text_color !important
        border-color noMatterLineColor !important
        // 保留原有的圆角
        border-radius 10px

        // 卡片内部的分区／标签容器
        // 这些容器是 .section 的后代，主题会给它们刷上不透明底色
        //（例如 youngcoder 的 .course-main-yc .section__body / .tab-layout /
        // .tab-content 与 .course-yc-table th），它们会盖住上面那个
        // z-index:-1 的亚克力伪元素，使卡片看起来是纯色、完全看不到毛玻璃
        .section__header
        .section__body
        .section__tab-header
        .tab-layout
        .tab-content
        .vertical-tabs
        .horizontal-tabs
        thead
        tbody
        tr
        th
        td
            background none !important
            background-image none !important

        // 首页签到卡片：站点给内部的方块写死了浅色底
        .homepage-checkin__body
        .homepage-checkin__fortune
        .homepage-checkin__countdowns
        .homepage-checkin__fortune-column
            background none !important
            background-image none !important

    // YCOJ 作业页的工具栏使用了独立的不透明底色
    .layout--basic.page--homework_main .section
        .hw-toolbar
        .hw-search-row
            background none !important

    // YCOJ 比赛页使用自定义容器，不在 Hydro 的 .section 卡片结构内
    .layout--basic.page--contest_main .contest-section
        if card-acrylic
            position relative
            acrylic(0.6, 20px)
            box-shadow none !important
        else
            background board_color !important
            box-shadow none !important
        color post_text_color !important
        border-radius 10px

        // 站点自定义过滤栏和表格容器会覆盖卡片的亚克力层
        .filter-row
        .contest-table-container
        tbody
        tr
        th
        td
            background none !important

    // YCOJ 比赛列表是独立于筛选栏的另一个容器，也需要单独建立亚克力层
    .layout--basic.page--contest_main .contest-table-container
        if card-acrylic
            position relative
            acrylic(0.6, 20px)
            box-shadow none !important
        else
            background board_color !important
            box-shadow none !important
        color post_text_color !important
        border-radius 10px

        thead
        tbody
        tr
        th
        td
            background none !important

    .section__header
        border-bottom 1px solid line_color
        .section__title
            color post_heading_color !important

    .section__title
        color post_heading_color !important

    .section__table-header
        background none !important
        border-radius 10px 10px 0 0

    .section__footer
        border-top 1px solid line_color

    .section__body
    .section__list
        color post_text_color !important

    .section__list-item
        border-top 1px solid line_color
    

    //! 表格 -----------------------------------------------------------

    .data-table
        color post_text_color
        th
            color post_heading_color !important
            background-color board_color !important
        tr
            border-color line_color !important
            background-color board_color !important
        th
            background-color board_color !important
        td
            border-color line_color !important
            background-color board_color !important


    //! 表单与按钮 -----------------------------------------------------

    input.textbox
    textarea.textbox
    .textbox
        color post_text_color !important
        background-color textBoxBackgroudColor !important
        // 站点自己给输入框配了明暗两套边框色，这里统一成主题分隔线色，
        // 否则「浅色站点 + 深色主题」时输入框会留一条亮边框
        border-color separator_color !important
        border-radius 10px !important
        &::placeholder
            color sec_text_color

    // 讨论区搜索框等没有 .textbox 的输入框同样处理
    input.discussion-search-input
        background-color textBoxBackgroudColor !important
        border-color separator_color !important
        color post_text_color !important

    input
    textarea
        accent-color post_link_color

    select
    .select
        color post_text_color !important
        background-color transparent !important
        border 1px solid line_color !important
        border-radius 10px !important

    .select-container.compact .select
    .select.compact
        border-radius 10px

    .button
        color button_text_color !important
        background-color transparent !important
        border 1px solid line_color !important
        border-radius 10px
        &:hover
        &:focus
            color button_text_color !important
            background-color button_hover_bg_color !important
            border-color line_color !important
            box-shadow none !important
        &.primary
            color #fff !important
            background-color post_link_color !important
            border-color post_link_color !important

    .search > input
        border-radius 10px 0 0 0

    .search > button
        border-radius 0 10px 0 0

    //! 弹层 -----------------------------------------------------------

    .dropdown .menu
    .drop-element .menu
        border-radius 10px
        if anymore-acrylic
            acrylic-bg()
        else
            background board_color !important
        color post_text_color
        border 1px solid line_color

    .menu__item
        color post_text_color !important
        border-radius 6px
        &:hover
            background button_hover_bg_color !important

    .dialog__content
        border-radius 10px
        if anymore-acrylic
            acrylic-bg()
        else
            background board_color !important

    .dialog
        background rgba(0, 0, 0, .45) !important

    .dialog__title
    .dialog__body
        color post_text_color

    .data-tooltip
    data-tooltip
    span.time.relative.tooltip
        border-radius 10px
        if anymore-acrylic
            acrylic-bg()
        else
            background board_color !important
        color post_text_color !important

    //! 正文与高亮 -----------------------------------------------------

    .typo
        color post_text_color !important
        h1
        h2
        h3
        h4
        h5
        h6
            color post_heading_color
        a
        a:active
        a:hover
        a:visited
            color post_link_color
        blockquote
            border-radius 7px
            border-left 3px solid line_color
            background rgba(acrylic_bg_color, .25)
            color sec_text_color
        hr
            border-color line_color
        table
        th
        td
            border-color line_color

    .typo .code-toolbar
        border-radius 10px

    code
        background inlinecode_bg_color !important
        color codeblock_text_color !important
        border-radius 6px

    pre
        background codeblock_bg_color !important
        color codeblock_text_color !important
        border-radius 10px
        border 1px solid codeblock_line_color
        code
            background none !important
            color inherit !important

    pre[class*=language-]
        border-radius 10px

    div.code-toolbar > .toolbar > .toolbar-item > a
    div.code-toolbar > .toolbar > .toolbar-item > button
    div.code-toolbar > .toolbar > .toolbar-item > span
        border-radius 0 0 0 10px

