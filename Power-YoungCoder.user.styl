/* ==UserStyle==
@name         Power-YoungCoder
@namespace    https://github.com/oyeah028/Power-YoungCoder
@version      1.1.0
@description  为 YoungCoder 修改设计：亮/暗双配色、可开关的亚克力材质、自定义背景与字体，并保留原有的圆角。改版后的站点把组件颜色收拢成了 CSS 变量（--home-*、--list-*、--yc-* 等），脚本会把它们一并映射到本主题调色板，避免新版组件保持站点原色。
@author       oyeah(deepseek二开)
@license      CC-BY-NC-SA-4.0
@preprocessor stylus

@var checkbox dark-mode "深色模式" 1

@var text font-stack "全局字体" "'Inter','Noto Sans SC',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif"
@var text font-stack-codeblock "代码块字体" "'Fira Code','JetBrains Mono','Noto Sans SC',monospace"

@var select bg-preset "背景方案" {
    "自定义（用下面的链接）": "custom",
}
@var text main-background "自定义背景图片（写成 url(...) 形式）" "url(https://pic.imgdb.cn/item/62df71a5f54cd3f9376f351d.jpg)"
@var checkbox background-fixed "背景固定不随页面滚动" 1

@var text content-opacity "内容不透明度（0 为完全透明，1 为不透明）" 1

@var checkbox header-acrylic "顶栏亚克力效果" 1
@var checkbox nav-acrylic "侧栏亚克力效果" 1
@var checkbox card-acrylic "卡片亚克力效果" 1
@var checkbox footer-acrylic "底栏亚克力效果" 1
@var checkbox anymore-acrylic "其余亚克力效果" 1

@var checkbox animations "动画" 1
==/UserStyle== */

@-moz-document domain("hydro.ac"), domain("youngcoder.cn")

    //! 调色板 ---------------------------------------------------------

    if dark-mode
        // 全局
        body_bg_color = #181c27
        navbar_bg_color = #1f3144
        navbar_text_color = #d0d0d0
        header_bg_color = #1f3144
        text_color = #c4c6c9
        sec_text_color = #a7a9ad
        board_color = #252d38
        post_text_color = #c4c6c9
        post_heading_color = #c4c6c9
        post_link_color = #1589e9
        link_hover_color = #30a9de
        line_color = #435266
        noMatterLineColor = #43526618
        // 组件
        button_text_color = #d0d0d0
        button_hover_bg_color = #46647e
        selection_bg_color = #9696c84d
        acrylic_bg_color = #000000
        textBoxBackgroudColor = #8080ad3d
        // 代码
        codeblock_bg_color = #0d1117
        inlinecode_bg_color = #636e7b66
        codeblock_text_color = #c9d1d9
        codeblock_line_color = #30363d
        // 滚动条
        scrollbar_track_color = #181c27
        scrollbar_thumb_color = #687582
        scrollbar_hover_color = #5e72e4
        // 语法高亮（Prism），null 表示沿用站点自带配色
        token_comment_color = #8b949e
        token_string_color = #a5d6ff
        token_keyword_color = #ff7b72
        token_function_color = #d2a8ff
        token_number_color = #79c0ff
        token_punct_color = #c9d1d9
        token_class_color = #7ee787
        token_attr_color = #ffa657
        token_regex_color = #a5d6ff
        // 站点自绘组件的语义色（把站点的 CSS 变量拉到本主题调色板，
        // 见“站点组件变量”一节）。canvas 是页面底色，surface 是面板，
        // raised/inset/alternate 分别是次级面板、凹陷区域、斑马纹，
        // separator 是分隔线，primary/secondary 是正文与次要文字
        canvas_color = body_bg_color
        surface_color = board_color
        raised_color = #2b3442
        inset_color = #1b202a
        alternate_color = #212a36
        hover_color = #303c4b
        separator_color = line_color
        primary_text_color = post_text_color
        secondary_text_color = sec_text_color
    else
        body_bg_color = #eee
        navbar_bg_color = #eeeeee
        navbar_text_color = #3c4858
        header_bg_color = #5eafca // Hydro 原本的顶栏蓝，保留品牌色
        text_color = #3c4858
        sec_text_color = #718096
        board_color = #fff
        post_text_color = #2c3e50
        post_heading_color = #1a202c
        post_link_color = #0366d6
        link_hover_color = #5f9fd6
        line_color = #e4e4e4
        button_text_color = #555
        button_hover_bg_color = #f2f3f5
        selection_bg_color = #95bce3
        acrylic_bg_color = #ffffff
        codeblock_bg_color = #f8f8f8
        inlinecode_bg_color = #636e7b26
        codeblock_text_color = #393a34
        codeblock_line_color = #e4e4e4
        scrollbar_track_color = #eeeeee
        scrollbar_thumb_color = #c4c6c9
        scrollbar_hover_color = #a6a6a6
        token_comment_color = null
        token_string_color = null
        token_keyword_color = null
        token_function_color = null
        token_number_color = null
        token_punct_color = null
        token_class_color = null
        token_attr_color = null
        token_regex_color = null
        // 见深色分支的同名变量
        canvas_color = body_bg_color
        surface_color = board_color
        raised_color = #f4f7fb
        inset_color = #fafbfd
        alternate_color = #fbfcfe
        hover_color = button_hover_bg_color
        separator_color = line_color
        primary_text_color = post_text_color
        secondary_text_color = sec_text_color

    // 背景方案 -> 实际背景值
    bg = main-background
    if bg-preset == 'monterey'
        bg = url(https://pic.imgdb.cn/item/62df71a5f54cd3f9376f351d.jpg)
    else if bg-preset == 'crystal'
        bg = url(http://www.pptbz.com/d/file/p/201708/a1d07b6201af8f574b6539cb724bbc16.png)
    else if bg-preset == 'cloud'
        bg = url(https://i.loli.net/2020/02/21/9uHQ2rLmTvkFtMj.png)
    else if bg-preset == 'anime'
        bg = url(https://c-ssl.duitang.com/uploads/item/201503/14/20150314184557_aPEfj.jpeg)
    else if bg-preset == 'random'
        bg = url(https://picsum.photos/1920/1080)
    else if bg-preset == 'random-blur'
        bg = url(https://picsum.photos/1920/1080?blur=10)
    else if bg-preset == 'vijos'
        bg = url(https://i.loli.net/2019/08/01/5d42d1bb1b30749952.png)
    else if bg-preset == 'solid'
        bg = none
    // 'custom'：bg 保持 main-background

    // 背景图加载完成前的兜底底色。
    // 这里必须用主题底色而不是 bg-color：深色模式下 bg-color 默认是 #F7F7F7，
    // 4MB 的壁纸加载期间整页会是浅色，看起来就跟站点原版界面一样
    if bg-preset == 'solid'
        panel_bg_color = bg-color
    else
        panel_bg_color = body_bg_color

    //! 亚克力材质 -----------------------------------------------------

    // 基于伪元素的实现，不会造成层叠混乱
    acrylic(arc-opacity=0.5, blur-radius=10px, no_shadow=false)
        background none !important
        &:before
            acr-bgcolor = rgba(acrylic_bg_color, arc-opacity)
            background acr-bgcolor !important
            // Safari 与旧版 Chromium 只认 -webkit- 前缀，缺了它亚克力会退化成
            // 一层纯色（看起来就像卡片没生效）
            -webkit-backdrop-filter blur(blur-radius) !important unless blur-radius == 0
            backdrop-filter blur(blur-radius) !important unless blur-radius == 0
            box-shadow    0 1px    3px    rgba(0, 0, 0, .01),
                        0 1px    8px        rgba(0, 0, 0, 0.2) unless no_shadow !important
            // 必须显式声明：vj4 的 clearfix 会给 .section:before 设置 display: table，
            // 而 display: table 的绝对定位元素会收缩成 0x0，导致亚克力完全不显示
            display block
            content    ""
            border-radius inherit
            position absolute
            pointer-events none
            z-index -1
            top 0
            left 0
            right 0
            bottom 0

    // 直接改背景的实现，不需要动 z-index，也不会影响 border-radius
    acrylic-bg(arc-opacity=0.5, blur-radius=10px, no_shadow=false)
        acr-bgcolor = rgba(acrylic_bg_color, arc-opacity)
        background acr-bgcolor !important
        -webkit-backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        box-shadow    0 1px    3px    rgba(0, 0, 0, .01),
                    0 1px    8px        rgba(0, 0, 0, 0.2) unless no_shadow !important

    // 指定底色的玻璃材质。顶栏自带品牌色（浅色下是 Hydro 的蓝），
    // 用 acrylic_bg_color 的话浅色下会变成白色，白色 logo 就看不见了
    glass(tint-color, arc-opacity=0.5, blur-radius=10px)
        background-color rgba(tint-color, arc-opacity) !important
        -webkit-backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        backdrop-filter blur(blur-radius) !important unless blur-radius == 0
        box-shadow    0 1px    3px    rgba(0, 0, 0, .01),
                    0 1px    8px        rgba(0, 0, 0, 0.2) !important

    //! 全局 -----------------------------------------------------------

    html, body
        scroll-behavior smooth
        background-color panel_bg_color !important

    // 页面背景：vj4 的 #panel 才是真正铺底色的容器（原本是 #edf0f2）
    // 只改 .main 的话顶栏、底栏前后的底色仍然会盖住背景图
    #panel
        background-color panel_bg_color !important
        background-image bg !important
        background-repeat no-repeat !important
        background-size cover !important
        background-position center !important
        if background-fixed
            // “不随页面滚动”用 fixed 定位的伪元素实现，而不是 background-attachment: fixed。
            // 后者的定位区域依赖视口，视口变化后可能仍按旧视口尺寸绘制（实测只铺满
            // 约一半视口，右侧和下侧露出背景色）。这里伪元素叠在 #panel 自己的背景图
            // 之上，即使伪元素没铺满，下面也有兜底，不会露底
            &::before
                content ""
                position fixed
                top 0
                left 0
                right 0
                bottom 0
                z-index -1
                pointer-events none
                background-image bg
                background-repeat no-repeat
                background-size cover
                background-position center

    // 站点自带的沉浸式布局背景
    .layout--immersive #panel
    .layout--immersive .header
        background-image none !important

    .main
        background none !important

    *::selection
        background selection_bg_color

    ::-webkit-scrollbar
        background scrollbar_track_color
        width 7px
        height 7px
    ::-webkit-scrollbar-thumb
        background scrollbar_thumb_color
    ::-webkit-scrollbar-thumb:hover
        background scrollbar_hover_color
    ::-webkit-scrollbar-corner
        background-color transparent

    body
        // 注意：Stylus 注入的 @var 值是原样文本（'Inter','Noto Sans SC',…），
        // 直接当值用即可。套 unquote() 只会剩下第一项，字体反而失效
        font-family font-stack !important
        color text_color !important

    // 站点给不少组件单独写死了文字色（例如 .training__intro 的 #777），
    // 加 !important 才能压住；后代元素自己的 color 规则依然优先，不受影响
    .main
        color post_text_color !important

    code, pre, .code-toolbar
        font-family font-stack-codeblock !important

    //! 站点组件变量 ------------------------------------------------

    // 改版后的站点把组件颜色都收拢成了 CSS 变量（--home-*、--list-*、--yc-*
    // 等等），每个变量自带一套浅色值，站点自己的深色模式再换成另一套。脚本是
    // 独立强制配色的（不跟随站点主题开关），所以必须自己把这批变量写一遍，
    // 否则作业/比赛/课程/消息这些新版组件会始终保持站点原本的浅色底。
    //
    // 取值规则：中性用途（底色、分隔线、正文）映射到本主题调色板；带色相的
    // （状态色、提示色、主题强调色）沿用站点自己的值，避免把语义色抹平。只对
    // 站点会随主题切换的变量做处理，纯版式变量（宽高、间距、圆角）不碰。
    // 站点改版后可以用仓库里的 tools/gen-tokens 重新生成这一段。


    site-token-values-light()
