        set-theme-tokens('--article-muted' '--auth-muted' '--copy-muted' '--course-muted' '--detail-muted' '--file-dialog-muted' '--sidebar-muted' '--yc-callout-note-line' '--yc-cover-muted' '--yc-info-muted' '--yc-placeholder-color' '--yc-side-muted', secondary_text_color)
        set-theme-tokens('--article-soft' '--bulletin-soft' '--contest-raised' '--contest-tab-soft' '--copy-soft' '--discussion-soft' '--file-dialog-soft' '--home-soft' '--hw-ended-soft' '--hw-soft' '--list-soft' '--pl-head' '--sidebar-soft' '--statement-soft' '--yc-dialog-soft' '--yc-info-option' '--yc-page-soft' '--yc-side-soft', raised_color)
        set-theme-tokens('--auth-bg' '--author-stats-bg' '--bulletin-bg' '--contest-surface' '--contest-tab-surface' '--copy-bg' '--course-surface' '--detail-bg' '--detail-tag-bg' '--discussion-surface' '--file-dialog-bg' '--home-surface' '--hw-surface' '--list-rule-bg' '--list-surface' '--md-theme-bg-color-scrollbar-thumb' '--pl-bg' '--pl-tag-bg' '--sidebar-bg' '--state-ended-bg' '--yc-callout-note-bg' '--yc-callout-red-bg' '--yc-callout-warn-bg' '--yc-dialog-bg' '--yc-filter-surface' '--yc-info-bg' '--yc-msg-bg' '--yc-side-bg', surface_color)
