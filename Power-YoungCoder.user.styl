    .syntax-hl .token.class-name
        color token_class_color if token_class_color

    .syntax-hl .token.attr-name
    .syntax-hl .token.entity
    .syntax-hl .token.property
        color token_attr_color if token_attr_color

    .syntax-hl .token.regex
        color token_regex_color if token_regex_color

    //! 其余组件 -------------------------------------------------------

    .numbox__text
    .supplementary
        color sec_text_color

    .chip-list__item
        border-radius 10px

    .pager
        border-top 2px solid line_color
        .pager__item
            border-top 2px solid line_color
            color post_text_color !important
            &:hover
                border-top-color link_hover_color
        .pager__item.active
            border-top-color post_link_color

    .user-profile-badge
        border-radius 7px
        box-shadow 0px 1px 3px rgba(0, 0, 0, .25)

    .user-profile-name
