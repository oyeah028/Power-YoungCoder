    // 比赛／作业／课程侧栏顶部的封面卡。站点原本铺一张蓝色渐变（并在右上方画两个
    // 白色圆环），文字被写死成白色；这里把封面还原成透明，让侧栏卡片的亚克力
    // 直接透上来，标题和元信息改用主题色（否则浅色模式下白字会糊在浅色亚克力上）
    // 课程页的侧栏只有 .section.side（没有 .yc-side-navigation），所以两个都要列
    #panel .yc-side-navigation.side > .contest-sidebar__bg
    #panel .section.side > .contest-sidebar__bg
        --yc-cover-ink: primary_text_color !important
        --yc-cover-muted: secondary_text_color !important
        background none !important
        color primary_text_color !important
        border-bottom none !important
        border-radius inherit

        &:before
        &:after
            content none !important

        .yc-cover-symbol
        .yc-cover-rule
            border-color separator_color !important
            background rgba(acrylic_bg_color, .35) !important
            color primary_text_color !important

    // 侧栏的属性列表（比赛／作业／题目信息）站点会刷一层不透明的
    // --yc-info-bg，在亚克力卡片上会留下一条硬分界，这里让它透出卡片本身；
    // 标签用的是写死的浅灰（--contest-muted），换成主题的次要文字色
    #panel .yc-side-navigation > .section__body
    #panel .section.side > .section__body
        background none !important

        dt
            color secondary_text_color !important

    .problem__tag-link
        border-radius 10px

    .autocomplete-wrapper
        border-radius 10px

    .balancer__body
        color post_text_color

    #status > .section__header
        padding 0.78125rem .9375rem

    //! 底栏 -----------------------------------------------------------

    .footer
        acrylic-bg(effective_acrylic_opacity, acrylic-blur) if footer-acrylic
        background board_color !important unless footer-acrylic
        color sec_text_color
        hr
            border-color line_color
        .footer__extra-link-item
        .footer__category__expander
            color sec_text_color !important
        a
            color sec_text_color !important
            &:hover
                color post_link_color !important

    // 页面顶部的加载进度条（nprogress 自己写死了品牌蓝）
    #nprogress .bar
        background post_link_color !important
    #nprogress .peg
        box-shadow 0 0 10px post_link_color, 0 0 5px post_link_color !important

    //! 圆角、材质与排版收敛 ------------------------------------------

    // :not(#...) 只增加权重，不改变匹配范围，用于压过站点的 ID+多类规则。
    html:root:not(#yc-theme-disabled) body #panel .section
    html:root:not(#yc-theme-disabled) body #panel .rank-panel
    html:root:not(#yc-theme-disabled) body #panel .profile-heatmap-card
    html:root:not(#yc-theme-disabled) body #panel .yc-home-card
    html:root:not(#yc-theme-disabled) body #panel .contest-section
    html:root:not(#yc-theme-disabled) body #panel .contest-table-container
    html:root:not(#yc-theme-disabled) body #panel .homepage-checkin
    html:root:not(#yc-theme-disabled) body #panel .homepage-study-heatmap
        if card-acrylic
            background-image linear-gradient(145deg, acrylic_sheen_color, transparent 45%) !important
            background-color rgba(acrylic_bg_color, effective_acrylic_opacity) !important
            box-shadow 0 1px 0 glass_highlight_color inset, 0 18px 48px glass_shadow_color !important
        else
            background board_color !important
        radius-all(corner-radius)
        border 1px solid rgba(line_color, .72) !important

    // 卡片内部的小列表与入口不再是一整块生硬的矩形。半透明底色让它们在
    // 亚克力卡片上保持层级，同时不会遮住背景。
    html:root #panel .yc-home-tile
    html:root #panel .yc-discussion-item
    html:root #panel .yc-home-ranking__row
    html:root #panel .group-list__item
    html:root #panel .homepage-checkin__fortune
    html:root #panel .homepage-checkin__countdowns
    html:root #panel .homepage-checkin__fortune-column
    html:root #panel .homework__item
        --home-surface rgba(acrylic_bg_color, .18) !important
        --yc-dark-surface rgba(acrylic_bg_color, .18) !important
        radius-all(12px)
        border 1px solid rgba(line_color, .52) !important
        background rgba(acrylic_bg_color, .16) !important
        -webkit-backdrop-filter blur(9px) saturate(1.08)
        backdrop-filter blur(9px) saturate(1.08)

    html:root #panel .yc-home-tile:hover
    html:root #panel .yc-discussion-item:hover
    html:root #panel .yc-home-ranking__row:hover
    html:root #panel .group-list__item:hover
    html:root #panel .homework__item:hover
        border-color rgba(post_link_color, .42) !important
        background rgba(acrylic_bg_color, .27) !important

    .section__header
        border-radius corner-radius corner-radius 0 0

    // 所有按钮和输入控件共享一套圆角，但保留站点自己的语义色和尺寸。
    button
    .button
    [class*="__button"]
    [class$="-btn"]
    input:not([type="checkbox"]):not([type="radio"]):not([type="range"])
    textarea
    select
        radius-all(control-radius)

    .yc-nav-theme-toggle
    .omnibar-toggle
        border-radius 50% !important

    // Prism 代码工具条的复制、填充按钮实际是 <a>，不在按钮类选择器里。
    html:root .code-toolbar .toolbar-item > a
    html:root .code-toolbar .toolbar-item > button
    html:root .code-toolbar .toolbar-item > span
        radius-all(8px)

    #menu.nav .nav__item
        radius-all(control-radius)
        transition background-color .2s ease, color .2s ease, box-shadow .2s ease

    #menu.nav .nav__item.nav--active
        background rgba(post_link_color, .16) !important
        box-shadow inset 0 0 0 1px rgba(post_link_color, .28) !important

    .homepage-checkin__button
        --yc-button-bg rgba(post_link_color, .24) !important
        --yc-button-hover rgba(post_link_color, .34) !important
        border 1px solid rgba(post_link_color, .42) !important
        background linear-gradient(135deg, rgba(post_link_color, .3), rgba(post_link_color, .13)) !important
        box-shadow 0 1px 0 glass_highlight_color inset, 0 7px 20px rgba(post_link_color, .12) !important

    .homepage-checkin__countdowns
        line-height 1.5

        h2
            line-height 1.4
            margin-bottom 6px

        .homepage-checkin__countdown-item
            display flex
            align-items center
            justify-content space-between
            gap 12px
            min-height 38px
            padding 4px 0
            font-size 14px !important
            line-height 1.5 !important

            span
                min-width 0
                overflow hidden
                white-space nowrap
                text-overflow ellipsis

            b
                flex none
                white-space nowrap

            em
                font-size 18px
                font-style normal
                font-weight 700

    .group-list__item
        padding 8px 10px

        .section__title
            line-height 1.45
            margin-bottom 4px

        .chip-list
            display flex
            flex-wrap wrap
            align-items center
            gap 4px 10px

        .chip-list__item
            padding 2px 0
            white-space nowrap

        .typo-a
            line-height 1.5

    html:root:not(#yc-theme-disabled) body #panel .yc-home-ranking__row .yc-home-ranking__rank
    html:root:not(#yc-theme-disabled) body #panel .yc-home-ranking__row .rank-position
        radius-all(50%)
        clip-path circle(50%) !important
        -webkit-clip-path circle(50%) !important

    html:root:not(#yc-theme-disabled) body #panel .discussion-panel .yc-discussion-list
        display flex
        flex-direction column
        gap 10px
        padding 12px
        list-style none

    html:root:not(#yc-theme-disabled) body #panel .yc-discussion-list > .yc-discussion-item
        position relative
        overflow hidden
        background-color rgba(raised_color, .44) !important
        background-image linear-gradient(145deg, rgba(255, 255, 255, .12), transparent 64%) !important
        border 1px solid rgba(line_color, .72) !important
        -webkit-backdrop-filter blur(14px) saturate(1.12)
        backdrop-filter blur(14px) saturate(1.12)
        box-shadow 0 1px 0 glass_highlight_color inset, 0 8px 22px rgba(0, 0, 0, .12)

    html:root:not(#yc-theme-disabled) body #panel .yc-discussion-list > .yc-discussion-item:hover
        background-color rgba(raised_color, .58) !important

    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group
        background-color rgba(raised_color, .24) !important
        background-image linear-gradient(135deg, glass_highlight_color, transparent 64%) !important
        border 1px solid rgba(line_color, .5) !important
        -webkit-backdrop-filter blur(12px) saturate(1.1)
        backdrop-filter blur(12px) saturate(1.1)
        color primary_text_color !important

    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group--red
        background-color rgba(#ef4652, .14) !important
        border-color rgba(#ef4652, .32) !important
    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group--orange
        background-color rgba(#f57c20, .14) !important
        border-color rgba(#f57c20, .32) !important
    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group--yellow
        background-color rgba(#eab308, .13) !important
        border-color rgba(#eab308, .3) !important
    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group--green
        background-color rgba(#22c55e, .13) !important
        border-color rgba(#22c55e, .3) !important
    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group--blue
        background-color rgba(#3b82f6, .14) !important
        border-color rgba(#3b82f6, .32) !important
    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group--purple
        background-color rgba(#a855f7, .14) !important
        border-color rgba(#a855f7, .32) !important

    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-group h3
        color primary_text_color !important

    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-link
        radius-all(8px)
        background rgba(acrylic_bg_color, .18) !important
        border 1px solid rgba(line_color, .24) !important
        color primary_text_color !important

    html:root:not(#yc-theme-disabled) body #panel .yc-node-panel .yc-node-link:hover
        background rgba(post_link_color, .16) !important
        border-color rgba(post_link_color, .34) !important
        color link_hover_color !important

    html:root:not(#yc-theme-disabled) body .main .user-profile-link > .user-profile-badge
        radius-all(999px)
        clip-path inset(0 round 999px) !important
        -webkit-clip-path inset(0 round 999px) !important

    // 正文与代码的字体大小分开控制。代码保留更紧凑的行高，长公式和缩进
    // 较多的样例不会因为换成正文大小而明显变松。
    .typo
        font-family font-stack !important
        font-size text-font-size !important
        line-height 1.78
        letter-spacing .01em

    // 不覆盖 .katex、.MathJax 或 mjx-container 的 font-family，
    // 公式继续使用站点加载的 KaTeX/MathJax 字体。

    .typo h1
    .typo h2
    .typo h3
    .typo h4
        line-height 1.34
        letter-spacing -.012em

    code
    pre
    kbd
    samp
    .code-toolbar
        font-family font-stack-codeblock !important
        font-variant-ligatures contextual

    pre
    pre code
    .code-toolbar pre
        font-size code-font-size !important
        line-height 1.65

    html:root #panel pre
    html:root #panel .code-toolbar
        radius-all(12px)

    :not(pre) > code
        font-size calc(code-font-size - 1px) !important

    //! 保留原有特性 ---------------------------------------------------

    // 内容不透明度（原本作用于 .columns / .slideout-menu）
    .columns
        opacity content-opacity

    if animations
        @keyframes argon-card-enter
            from
                opacity 0
                transform translateY(1.5rem)
            to
                opacity 1
                transform translateY(0)

        .section
        .rank-panel
        .profile-heatmap-card
        .contest-section
        .contest-table-container
            animation argon-card-enter .45s ease-out both

        .section
        .button
        .textbox
        .pager__item
        .typo a
            transition background-color .3s ease, color .3s ease, border-color .3s ease
