    //! 保留原有特性 ---------------------------------------------------

    // 内容不透明度（原本作用于 .columns / .slideout-menu）
    .columns
        opacity content-opacity

    if animations
        @keyframes argon-card-enter
            from
                opacity 0
                transform translateY(1.5rem)
            to
                opacity 1
                transform translateY(0)

