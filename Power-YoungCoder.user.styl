    html, body, body *
        if dark-mode
            site-token-values-dark()
        else
            site-token-values-light()
        --yc-dark-page: canvas_color !important
        --yc-dark-surface: surface_color !important
        --yc-dark-raised: raised_color !important
        --yc-dark-inset: inset_color !important
        --yc-dark-alternate: alternate_color !important
        --yc-dark-hover: hover_color !important
        --yc-dark-line: separator_color !important
        --yc-dark-text: primary_text_color !important
        --yc-dark-muted: secondary_text_color !important
        --yc-ui-surface: rgba(acrylic_bg_color, effective_acrylic_opacity) !important
        --yc-ui-row: rgba(line_color, .28) !important

    // 新版站点已通过 CSS 变量承载主题色；旧版硬编码色块不再生成。
    // 只保留仍会被站点高权重规则覆盖的标题颜色。
    html:root body .main h1
    html:root body .main h2
    html:root body .main h3
    html:root body .main h4
    html:root body .main h5
    html:root body .main h6
        color primary_text_color !important

    //! 顶栏 -----------------------------------------------------------

    // 改版后站点把原来的顶部横幅并进了固定导航条：logo 与站点名现在都在
    // #menu.nav 里（见下），只有窄屏下才显示 .header--mobile 这条细顶栏。
    // 因此「顶栏亚克力」这个开关现在作用于窄屏顶栏，桌面端由「侧栏亚克力」
    // （#menu.nav）负责。
    .header--mobile
        background-image none !important
        if header-acrylic
            glass(header_bg_color, header_glass_opacity)
        else
            background-color header_bg_color !important
        color #fff !important

        .header--mobile__domain
        .header__hamburger
            color #fff !important

        .hamburger-inner
            &
            &:before
            &:after
                background-color #fff !important

    // 固定导航条
    #menu.nav
        if nav-acrylic
            glass(navbar_bg_color, nav_glass_opacity)
        else
            background-color navbar_bg_color !important
        color navbar_text_color !important

        &.floating
            if nav-acrylic
                glass(navbar_bg_color, nav_glass_opacity)
            else
                background-color navbar_bg_color !important
            box-shadow none

        .nav__list-item
            color navbar_text_color !important

        .nav__item
        .nav__item--round
            color navbar_text_color !important
            border-radius 6px
            &:active
            &:visited
                color navbar_text_color !important
            &:hover
                color navbar_text_color !important
                background button_hover_bg_color
            &.nav--active
                border-color link_hover_color
                &:before
                    box-shadow none

    // 侧栏（小屏幕下的抽屉菜单）
    .slideout-menu
        if nav-acrylic
            glass(navbar_bg_color, nav_glass_opacity)
        else
            background-color navbar_bg_color !important
        color navbar_text_color !important
        opacity content-opacity

    .slideout-overlay
        opacity content-opacity

    //! 卡片 -----------------------------------------------------------

    // vj4 的卡片是 .section，原本是纯白 + 大阴影。
    // 改版后的站点又加了几种独立的卡片容器（排名面板、个人主页热力图、
    // 首页卡片），它们不在 .section 结构里，但外观相同，所以共用同一套配方
    //
    // 选择器前面挂 html:root #panel 是为了权重：改版后的站点用
    // `#panel .页 .面板 { background: var(--contest-surface) !important }` 这种
    // 「ID + 双类 + !important」的写法给卡片和表格刷底色，普通 .section 压不住，
    // 卡片会退回纯色，盖住主题设置的亚克力底色。
    // html:root 把权重抬到 (1 id, 2 class, 1 type)，比站点的 (1, 2, 0) 高，
    // 含义仍然是同一批元素，不改作用范围。
    // 注意：这里不能用 :is(...) 收拢，Stylus 展开嵌套选择器时会把 :is() 里的
    // 最后一个分支拽到括号外面，后代规则会全部失效
    html:root #panel .section
    html:root #panel .rank-panel
    html:root #panel .profile-heatmap-card
    html:root #panel .yc-home-card
        if card-acrylic
            position relative
            acrylic(effective_acrylic_opacity, acrylic-blur)
            --yc-dark-surface rgba(acrylic_bg_color, effective_acrylic_opacity) !important
            --home-surface rgba(acrylic_bg_color, effective_acrylic_opacity) !important
            --contest-surface rgba(acrylic_bg_color, effective_acrylic_opacity) !important
            --course-surface rgba(acrylic_bg_color, effective_acrylic_opacity) !important
            --detail-bg rgba(acrylic_bg_color, effective_acrylic_opacity) !important
            --yc-info-bg rgba(acrylic_bg_color, effective_acrylic_opacity) !important
        else
            background board_color !important
            box-shadow none !important
        color post_text_color !important
        border-color noMatterLineColor !important
        border-radius corner-radius !important

        .section__header
        .section__body
        .section__tab-header
        .tab-layout
        .tab-content
        .vertical-tabs
        .horizontal-tabs
        details
        summary
        table
        thead
        tbody
        tr
        th
        td
            background none !important
            background-image none !important

        .homepage-checkin__body
        .homepage-checkin__fortune
        .homepage-checkin__countdowns
        .homepage-checkin__fortune-column
            background none !important
            background-image none !important

    // YCOJ 作业页的工具栏使用了独立的不透明底色
    .layout--basic.page--homework_main .section
        .hw-toolbar
        .hw-search-row
            background none !important

    // YCOJ 比赛页使用自定义容器，不在 Hydro 的 .section 卡片结构内
    .layout--basic.page--contest_main .contest-section
        if card-acrylic
            position relative
            acrylic(effective_acrylic_opacity, acrylic-blur)
        else
            background board_color !important
            box-shadow none !important
        color post_text_color !important
        border-radius corner-radius !important

        .filter-row
        .contest-table-container
        tbody
        tr
        th
        td
            background none !important

    // YCOJ 比赛列表是独立于筛选栏的另一个容器，也需要单独建立亚克力层
    .layout--basic.page--contest_main .contest-table-container
        if card-acrylic
            position relative
            acrylic(effective_acrylic_opacity, acrylic-blur)
        else
            background board_color !important
            box-shadow none !important
        color post_text_color !important
        border-radius corner-radius !important

        thead
        tbody
        tr
        th
        td
            background none !important

    .section__header
        border-bottom 1px solid line_color
        .section__title
            color post_heading_color !important

    // 题目概览的标签行紧贴标题，不保留标题底部分割线。
    .yc-problem-overview > .section__header
        border-bottom none !important

    .section__title
        color post_heading_color !important

    .section__table-header
        background none !important
        border-radius 10px 10px 0 0

    .section__footer
        border-top 1px solid line_color

    .section__body
    .section__list
        color post_text_color !important

    //! 表格 -----------------------------------------------------------

    .data-table
        color post_text_color
        th
            color post_heading_color !important
            background-color board_color !important
        tr
            border-color line_color !important
            background-color board_color !important
        th
            background-color board_color !important
        td
            border-color line_color !important
            background-color board_color !important

    //! 表单与按钮 -----------------------------------------------------

    input.textbox
    textarea.textbox
    .textbox
        color post_text_color !important
        background-color textBoxBackgroudColor !important
        border-color separator_color !important
        border-radius 10px !important
        &::placeholder
            color sec_text_color

    // 讨论区搜索框等没有 .textbox 的输入框同样处理
    input.discussion-search-input
        background-color textBoxBackgroudColor !important
        border-color separator_color !important
        color post_text_color !important

    input
    textarea
        accent-color post_link_color

    select
    .select
        color post_text_color !important
        background-color transparent !important
        border 1px solid line_color !important
        border-radius 10px !important

    .select-container.compact .select
    .select.compact
        border-radius 10px

    .button
        color button_text_color !important
        background-color transparent !important
        border 1px solid line_color !important
        border-radius 10px
        &:hover
        &:focus
            color button_text_color !important
            background-color button_hover_bg_color !important
            border-color line_color !important
            box-shadow none !important
        &.primary
            color #fff !important
            background-color post_link_color !important
            border-color post_link_color !important

    .search > input
        border-radius 10px 0 0 0

    .search > button
        border-radius 0 10px 0 0

    //! 弹层 -----------------------------------------------------------

    .dropdown .menu
    .drop-element .menu
        border-radius 10px
        if anymore-acrylic
            acrylic-bg()
        else
            background board_color !important
        color post_text_color
        border 1px solid line_color

    .menu__item
        color post_text_color !important
        border-radius 6px
        &:hover
            background button_hover_bg_color !important

    .dialog__content
        border-radius 10px
        if anymore-acrylic
            acrylic-bg()
        else
            background board_color !important

    .dialog
        background rgba(0, 0, 0, .45) !important

    .dialog__title
    .dialog__body
        color post_text_color

    //! 正文与高亮 -----------------------------------------------------

    .typo
        color post_text_color !important
        h1
        h2
        h3
        h4
        h5
        h6
            color post_heading_color
        a
        a:active
        a:hover
        a:visited
            color post_link_color
        blockquote
            border-radius 7px
            border-left 3px solid line_color
            background rgba(acrylic_bg_color, .25)
            color sec_text_color
        hr
            border-color line_color
        table
        th
        td
            border-color line_color

    .typo .code-toolbar
        border-radius 10px

    code
        background inlinecode_bg_color !important
        color codeblock_text_color !important
        border-radius 6px

    pre
        background codeblock_bg_color !important
        color codeblock_text_color !important
        border-radius 10px
        border 1px solid codeblock_line_color
        code
            background none !important
            color inherit !important

    pre[class*=language-]
        border-radius 10px

    div.code-toolbar > .toolbar > .toolbar-item > a
    div.code-toolbar > .toolbar > .toolbar-item > button
    div.code-toolbar > .toolbar > .toolbar-item > span
        border-radius 0 0 0 10px

